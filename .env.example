PORT=5173
HOST=127.0.0.1
UPSTREAM_ORIGIN=https://jinliaicaiwu.top
# 本地后端就绪后填（如 http://127.0.0.1:8000）；留空则 /api 代理到云端
LOCAL_API_ORIGIN=
# 智能体 LLM（DeepSeek），仅从环境变量读取，禁止写入代码或版本库
DEEPSEEK_API_KEY=
# 模型名（可选）。官方 /v1/models 只接受 deepseek-flash (V4.1-Flash) 与
# deepseek-v4-pro；dsv4.1f1017 / deepseek-chat 等别名由 backend/llm.mjs 自动归一。
# 留空则回落 deepseek-flash。自定义 OpenAI 兼容服务可改 DEEPSEEK_BASE_URL
DEEPSEEK_MODEL=dsv4.1f1017
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 妆点管账「设置-开放令牌」生成的 OpenToken；填写后本地 /mcp 自动注入 Bearer，供 WorkBuddy 连接器直连
WB_MCP_TOKEN=
# 格式转换桥：默认用项目自带的本地零依赖实现（Filee CLI 协议兼容，无需 .NET / LibreOffice）
# 相对路径按项目根解析；也可改成官方 filee-cli.exe 绝对路径，或填 filee / filee-cli 走 PATH
# 把 CSV / XLSX / HTML 报表转成 PDF / DOCX / ODS / ODT / RTF / 图片等；留空则只用内置 5 种格式
FILEE_CLI=tools/filee-bridge.mjs
# 可选：指定带 Pillow 的 Python（PDF/PNG/JPG/WEBP 渲染用，不填会自动探测）
# FILEE_PYTHON=D:/tools/Python311/python.exe

# 注册来源策略：open=任何来源都可注册（默认，便于迁移到新设备）
#              local=仅本机  closed=完全关闭（只能用 npm run account -- register 建号）
# 迁移做法：新机首次部署用 open 注册管理员，之后改回 local 或 closed
REGISTER_MODE=open
