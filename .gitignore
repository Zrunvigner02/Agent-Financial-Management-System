# ===== 密钥 / 本地配置（绝不入库）=====
.env
.env.*
!.env.example
.local/
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.*
backend/data/*.sqlite*
backend/data/*.bak*

# ===== 依赖与运行时二进制（可由 npm / 桌面端安装器重建）=====
node_modules/
desktop/runtime/
*.exe
*.dll
*.pak
*.dat
__pycache__/
*.pyc

# ===== 本地生成物 / 超大逆向产物 =====
analysis/*.gz
logs/
*.tmp
*.local-only.zip
release/*.zip.tmp
.DS_Store
Thumbs.db

# 报表导出物（本地生成，不入库）
exports/

# 上传附件（业务数据，不入库）
data/attachments/

# 发布压缩包（本地构建产物，不入库）
release/*.zip
.backup-*/
data/*.lock

# ===== RPA 本机校准（每台机器屏幕/窗口都不同，绝不入库）=====
tools/rpa/wdt-coords.ini
tools/rpa/wdt-coords-check.txt
tools/rpa/wdt-export.log
tools/rpa/*.out

# AutoHotkey 运行时（体积大，按 docs/WDT-OPENAPI.md 说明自行下载）
tools/bin/

# 备份区（企微导出文件 + 数据库快照，含业务数据，体积大）
备份/
